# ==============================================================================
# CREATORFLOW AI - Production Environment Configuration Reference
# For local development: copy to .env.local and configure keys
# For Vercel / Cloudflare Pages / Render: add these in Project Settings -> Environment Variables
# ==============================================================================

# Public Application URL (Update to your live Vercel URL on production)
# Local: http://localhost:3000
# Production: https://<your-project-name>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Database & Auth Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-this-server-side-only

# ------------------------------------------------------------------------------
# Google Gemini Generative AI Configuration
# Obtain from: Google AI Studio (https://aistudio.google.com/app/apikey)
# Tested and verified with model: gemini-3.5-flash-lite
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# Google Cloud Platform & YouTube Data API v3 OAuth Configuration
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
#
# REQUIRED SCOPES:
# - https://www.googleapis.com/auth/youtube.upload
# - https://www.googleapis.com/auth/youtube.readonly
# - https://www.googleapis.com/auth/yt-analytics.readonly
#
# AUTHORIZED REDIRECT URIS (Add BOTH to Google Cloud Console):
# Local:      http://localhost:3000/api/youtube/callback
# Production: https://<your-project-name>.vercel.app/api/youtube/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# (Optional) Secret for HMAC OAuth state signing (falls back to SUPABASE_SERVICE_ROLE_KEY)
OAUTH_STATE_SECRET=your-random-32-character-secret-key-here

# ------------------------------------------------------------------------------
# Razorpay INR Subscription Gateway (Optional in Sandbox / Test Mode)
# Obtain from: Razorpay Dashboard -> Settings -> API Keys (Test Mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ------------------------------------------------------------------------------
# Platform Owner Privileges (Grants automatic lifetime Pro to creator)
# ------------------------------------------------------------------------------
OWNER_EMAIL=jaspreetsing3412@gmail.com

# ------------------------------------------------------------------------------
# Sandbox & Interactive Demo Mode
# Set to 'true' for preview sandboxes, 'false' for strict production enforcement
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=true

# Master Admin Passkey Security
ADMIN_MASTER_KEY=your_secret_admin_master_passkey_here
ADMIN_OWNER_EMAIL=admin@yourdomain.com

